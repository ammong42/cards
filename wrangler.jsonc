{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cardtable",
  "workers_dev": true,
  "main": "server/worker.js",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "CardRoom" },
      { "name": "LIMITS", "class_name": "RateLimiter" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CardRoom", "RateLimiter"] },
  ],
}
